# Apollo.io API Configuration
# Get your API key from: https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# Alternative: Clay API (if using Clay instead)
CLAY_API_KEY=

# Output settings
OUTPUT_DIR=./outreach_results
OUTPUT_FORMAT=csv

# Search filters
TARGET_ROLES=CFO,VP Finance,Head of Finance,Controller
TARGET_SERIES=Series B,Series C,Series D,Series E
TARGET_INDUSTRIES=SaaS,Software,FinTech,HealthTech,DevTools
MIN_EMPLOYEES=50
MAX_EMPLOYEES=2000
LOCATIONS=United States,Canada,United Kingdom,Germany,France

# Rate limiting (Apollo: 100 requests/minute free tier)
REQUESTS_PER_MINUTE=80